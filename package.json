{
  "name": "sshotpin",
  "productName": "스샷핀",
  "version": "0.6.5",
  "description": "스샷핀 (SshotPin)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "author": "SshotPin (sshot-pin.web.app)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.sshotpin.app",
    "productName": "스샷핀",
    "artifactName": "SshotPin-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "wasabia137",
        "repo": "sshotpin"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.education",
      "artifactName": "SshotPin-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Yongsu Jung (T5YN2MB5DY)",
      "notarize": false
    },
    "dmg": {
      "title": "스샷핀"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "스샷핀",
      "installerLanguages": [
        "ko_KR"
      ]
    },
    "copyright": "Copyright (c) 2026 SshotPin (sshot-pin.web.app)"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}