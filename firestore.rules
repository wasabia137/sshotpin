rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 다운로드 버튼 클릭 수 (stats/downloads: win, mac)
    // 누구나 읽을 수 있고, 쓰기는 두 값 중 하나를 1 올리는 것만 허용한다.
    match /stats/downloads {
      allow read: if true;

      allow update: if request.resource.data.keys().hasOnly(['win', 'mac'])
        && request.resource.data.win is int
        && request.resource.data.mac is int
        && (
          (request.resource.data.win == resource.data.win + 1
            && request.resource.data.mac == resource.data.mac)
          ||
          (request.resource.data.mac == resource.data.mac + 1
            && request.resource.data.win == resource.data.win)
        );

      allow create, delete: if false;
    }

    // 방문자 수 (stats/visits: total)
    // 누구나 읽을 수 있고, 쓰기는 total을 정확히 1 올리는 것만 허용한다.
    // 문서가 아직 없을 때 첫 방문자가 만들 수 있도록 create를 열어두되,
    // 값은 0 또는 1만 허용한다. delete는 막혀 있으므로 한 번만 만들어진다.
    match /stats/visits {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1;

      allow update: if request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total is int
        && request.resource.data.total == resource.data.total + 1;

      allow delete: if false;
    }

    // 방명록 (guestbook/{id}: name, text, at, lang)
    // 로그인 없이 누구나 쓸 수 있으므로 규칙에서 형태를 엄격히 제한한다.
    // 서버 시각(request.time)을 강제해 조작된 날짜로 상단을 차지할 수 없게 한다.
    match /guestbook/{entry} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'at', 'lang'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 5
        // 서버 시각과 크게 어긋난 날짜를 막는다. 정확히 같기를 요구하면
        // 클라이언트·서버 시계 차이 때문에 정상 글까지 거부된다(실측).
        && request.resource.data.at is timestamp
        && request.resource.data.at < request.time + duration.value(5, 'm')
        && request.resource.data.at > request.time - duration.value(1, 'h');

      // 한 번 남긴 글은 아무도 고치거나 지울 수 없다 (관리는 콘솔에서)
      allow update, delete: if false;
    }

    // 그 밖은 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
